# --- Connection -------------------------------------------------------------
# GitHub token: fine-grained PAT (preferred), classic PAT, or a GitHub App
# installation token. Grant the LEAST privilege you need — read-only to start.
GHE_TOKEN=your-token

# API base URL.
#   GitHub Enterprise Cloud  -> https://api.github.com  (default)
#   GitHub Enterprise Server -> https://HOST/api/v3
GHE_API_URL=https://api.github.com

# Enterprise slug — enables enterprise-level endpoints (enterprise audit log,
# enterprise Actions policy). Leave empty if you only manage organizations.
GHE_ENTERPRISE=

# Per-request timeout and pagination cap (pages of 100 items).
GHE_TIMEOUT_MS=20000
GHE_MAX_PAGES=10

# --- Governance & security flags -------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
GHE_MODE=read-only

# Comma-separated organization allowlist. Empty = every org the token can see.
# Pin this to the exact orgs you intend to manage.
GHE_ORG_ALLOWLIST=

# Organizations that can be read but NEVER mutated (read-only forever),
# regardless of mode — e.g. a shared platform or security org.
GHE_PROTECTED_ORGS=

# Destructive ops (remove_member, delete_team, delete_repository,
# delete_org_ruleset, delete_webhook) require this IN ADDITION to admin mode.
GHE_ALLOW_DELETE=false

# High-impact ops require a typed confirmation that matches the exact target.
GHE_REQUIRE_CONFIRMATION=true

# Validate + log writes without sending them to GitHub.
GHE_DRY_RUN=false

# Emit a JSON audit line to stderr per guarded operation.
GHE_AUDIT_LOG=true

# Refuse destructive / high-impact ops when the client cannot show a human approval prompt
# (instead of trusting GHE_ALLOW_DELETE alone).
GHE_REQUIRE_HUMAN_APPROVAL=false

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block.
# Runs AFTER the deterministic gates; only tightens, never grants; fails closed.
#   off | monitor | enforce
GHE_GUARD_MODE=off
GHE_GUARD_URL=http://127.0.0.1:8799
GHE_GUARD_TIMEOUT_MS=2000
GHE_GUARD_FAIL_CLOSED=confirm
